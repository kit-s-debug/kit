{
  "name": "chrysalis-beautique",
  "private": true,
  "description": "The Chrysalis Beautique website. The built bundle (js/app.js) is committed, so the site runs without a build; rebuild after editing src/.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=esm --target=es2019 --outfile=js/app.js",
    "watch": "esbuild src/main.js --bundle --format=esm --target=es2019 --outfile=js/app.js --watch",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lenis": "1.3.17",
    "three": "0.170.0"
  }
}
