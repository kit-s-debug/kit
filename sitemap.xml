<?xml version="1.0" encoding="UTF-8"?>
<!--
  Llangwm RFC sitemap.

  BEFORE LAUNCH: replace REPLACE-WITH-YOUR-DOMAIN below with the site's real
  address. A sitemap needs absolute URLs, so it does nothing until then.

  The same address is needed in three files:
    1. this file          - the three <loc> lines below
    2. robots.txt         - the Sitemap: line
    3. index.html         - the og:image meta tag
  A sitemap needs absolute URLs, so they cannot be left relative.

  Only these three pages belong here (404.html is noindex). Do not add entries for pages that are not real.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://REPLACE-WITH-YOUR-DOMAIN/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://REPLACE-WITH-YOUR-DOMAIN/privacy.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://REPLACE-WITH-YOUR-DOMAIN/accessibility.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
