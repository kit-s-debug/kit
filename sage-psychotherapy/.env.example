# ---------------------------------------------------------------------------
# Sage Psychotherapy — environment
# Copy to .env.local for development, and set the same keys in Vercel for
# production (Project → Settings → Environment Variables).
# Nothing here is secret to the site's visitors; the site sets no cookies and
# stores nothing. These configure email delivery and the booking calendar.
# ---------------------------------------------------------------------------

# Canonical site origin, no trailing slash. Used for absolute URLs, the
# sitemap, canonical tags and Open Graph. On Vercel the production URL is
# detected automatically, so this is mainly for local runs and custom domains.
NEXT_PUBLIC_SITE_URL=https://sagepsychotherapy.co.uk

# --- Cal.com (the booking calendar) ---------------------------------------
# Lyndsay's public booking link, in the form "username/event-slug".
# Create a free account at cal.com, add a 15-minute event type called e.g.
# "free-call", then put "her-username/free-call" here. See the README for the
# full setup (duration, buffers, working hours, calendar connection).
# Leave blank and the booking step shows her phone number instead.
NEXT_PUBLIC_CAL_LINK=

# --- Resend (the enquiry email) -------------------------------------------
# The enquiry form emails Lyndsay and stores nothing. Create a key at
# resend.com, verify her sending domain, then set:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered (her inbox):
ENQUIRY_TO=lyndsay@sagepsychotherapy.co.uk
# The verified from-address (must be on the domain verified with Resend):
ENQUIRY_FROM=Sage Psychotherapy <enquiries@sagepsychotherapy.co.uk>
