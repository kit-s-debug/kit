# Copy to .env and set on your host too. Leave both unset and the contact
# form falls back to opening the visitor's mail client, which still works
# but converts far worse than a real submit.

# Formspree or Basin: create a form, paste its URL here. Nothing else needed.
#   VITE_FORM_ENDPOINT=https://formspree.io/f/yourid
#
# Web3Forms: no account needed. Get a key at web3forms.com and set both:
#   VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
#   VITE_FORM_ACCESS_KEY=your-key
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
