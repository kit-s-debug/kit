# ---------------------------------------------------------------------------
# FLOWSTATE environment
#
# Every variable here is OPTIONAL. With none of them set, the app runs fully:
# rhymes, topic detection, beats, scoring and the written observations all come
# from the on-device engine. Setting a key only upgrades the *line ideas* and
# the end-of-session review.
#
# Copy to .env.local (which is gitignored) and fill in what you have.
# ---------------------------------------------------------------------------

# Enables the hosted-model provider for line ideas and session observations.
# Read only on the server, in app/api/ai/*. Never exposed to the browser.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Which model the hosted provider uses.
# Default: claude-haiku-4-5-20251001 — chosen because latency matters more than
# depth for a four-word line suggestion.
FLOWSTATE_AI_MODEL=
